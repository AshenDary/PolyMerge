# --- Server ---
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
CORS_ORIGIN=http://127.0.0.1:3000
# The local supervisor supplies production restrictions and matching child URLs.

# --- Backend Database (Prisma / MySQL) ---
# Legacy only; not required by the supervised local demonstration.
MYSQL_PORT=3306
DATABASE_URL=""
# Prisma Migrate uses this local-only shadow DB, created by docker-compose init.
SHADOW_DATABASE_URL=""

# --- ML Engine ---
ML_SERVICE_URL="http://localhost:8000"
ML_SERVICE_TIMEOUT_MS=15000
# Catalog and health calls should fail fast; candidate generation can take
# about a minute locally and may queue behind another ML/graph request.
ML_CATALOG_TIMEOUT_MS=10000
ML_HEALTH_TIMEOUT_MS=5000
ML_CANDIDATE_TIMEOUT_MS=150000
# Optional absolute path to the reviewed Sprint 5 joblib artifact.
# Defaults to models/sprint5/random_forest_ddi_pipeline.joblib.
# POLYMERGE_DDI_MODEL_PATH="C:/secure/model-store/random_forest_ddi_pipeline.joblib"

# --- Neo4j Knowledge Graph ---
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD=""

# --- Auth / Security ---
# Never commit a real secret. Generate locally: openssl rand -hex 32
JWT_SECRET=""

# --- Logging ---
LOG_LEVEL=info
