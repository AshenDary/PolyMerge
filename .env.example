# --- Server ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# --- Backend Database (Prisma / MySQL) ---
# Matches docker-compose "mysql" service below.
MYSQL_PORT=3306
DATABASE_URL="mysql://polymerge:polymerge@localhost:3306/polymerge"
# Prisma Migrate uses this local-only shadow DB, created by docker-compose init.
SHADOW_DATABASE_URL="mysql://polymerge:polymerge@localhost:3306/polymerge_shadow"

# --- ML Engine ---
ML_SERVICE_URL="http://localhost:8000"
ML_SERVICE_TIMEOUT_MS=15000

# --- Neo4j Knowledge Graph ---
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="password"

# --- Auth / Security ---
# Never commit a real secret. Generate locally: openssl rand -hex 32
JWT_SECRET="change-me-in-local-env"

# --- Logging ---
LOG_LEVEL=info
