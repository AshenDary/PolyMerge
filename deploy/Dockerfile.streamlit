FROM python:3.11-slim-trixie@sha256:e88e9763f943ec1834f992a4b51e0f24500486803e8bc534e5767af9ea65f6ce
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8501
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends liblzma5=5.8.1-1+deb13u2 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-streamlit.lock ./
RUN pip install --no-cache-dir --require-hashes -r requirements-streamlit.lock && useradd --uid 10001 --create-home app
RUN pip uninstall -y setuptools wheel pip
RUN find / -xdev -type f -perm /6000 -exec chmod a-s {} +
COPY streamlit_app.py ./
COPY .streamlit ./.streamlit
USER app
EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.environ['PORT']+'/_stcore/health',timeout=4)"
CMD ["sh", "-c", "exec streamlit run streamlit_app.py --server.address 0.0.0.0 --server.port \"$PORT\" --browser.gatherUsageStats false"]
