generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model QueryLog {
  id              Int      @id @default(autoincrement())
  query           String   @db.Text
  responseSummary String?  @db.Text
  createdAt       DateTime @default(now())
}
